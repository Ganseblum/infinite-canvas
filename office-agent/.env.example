# 契约二内网共享密钥（Go 与 office-agent 两侧注入同一随机值；必填，未设置服务拒绝启动）
OFFICE_INTERNAL_TOKEN=change-me-to-a-random-secret

# 监听端口（默认 8902）
OFFICE_PORT=8902

# 工作区根目录（每 sessionId 一个子目录；transcripts 落在其同级 transcripts/ 下）
OFFICE_WORKSPACE_DIR=./workspaces

# Anthropic Messages 协议网关（模型 key 服务端保管，不下发前端）
ANTHROPIC_BASE_URL=https://your-gateway.example
ANTHROPIC_AUTH_TOKEN=sk-placeholder
ANTHROPIC_MODEL=glm-5.3
