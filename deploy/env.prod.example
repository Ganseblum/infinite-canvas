# ===== 正式环境（xxx 域名）=====
# 复制成 deploy/env.prod 后填写，并保存在服务器上（不要提交进 git）。

# 镜像与端口：镜像 tag 按环境区分（测试环境用 :test）；端口只绑 127.0.0.1，公网访问走宿主机 nginx
APP_IMAGE=infinite-canvas:prod
API_IMAGE=infinite-canvas-api:prod
ADMIN_IMAGE=infinite-canvas-admin:prod
APP_PORT=3200
ADMIN_PORT=3201

# compose 项目名兜底：deploy.sh 已用 -p infinite-canvas-prod 隔离（-p 优先级更高），
# 这里防有人绕过 deploy.sh 直接 docker compose 时与测试环境混用容器与数据目录
COMPOSE_PROJECT_NAME=infinite-canvas-prod

MYSQL_DATABASE=infinite_canvas
MYSQL_USER=canvas
MYSQL_PASSWORD=change-me-strong-random
MYSQL_ROOT_PASSWORD=change-me-strong-random-root
DATABASE_URL=canvas:change-me-strong-random@tcp(db:3306)/infinite_canvas?charset=utf8mb4&parseTime=True&loc=UTC

# 正式环境必须是 production，否则会显示测试环境标识
SITE_ENV=production
API_BASE_URL=
APP_BASE_URL=https://xxx.example.com
COOKIE_SECURE=true
TRUSTED_PROXIES=172.16.0.0/12
# 跨源白名单：逗号分隔的完整来源（scheme://host[:port]，不带路径、尾斜杠或通配符），例如 https://sim-admin.youc.online
# 留空即完全不启用 CORS；同源部署无需配置
# 管理后台是独立域名，上线时必须填上正式后台的来源，否则 admin 的跨源请求会被浏览器拦下
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# ===== 管理后台（独立容器，正式域名）=====
# 注意与上面的 API_BASE_URL 是两个不同的键，别混：
#   API_BASE_URL       主站前端的，同源部署时留空，由 app 容器内 nginx 反代 /api；
#   ADMIN_API_BASE_URL 管理后台的，必须是非空绝对地址（admin 域上没有 /api，留空会让请求打到 admin 自己身上变 404，
#                      admin 容器入口脚本会因此拒绝启动）。正式环境填主站正式域名。
ADMIN_API_BASE_URL=https://xxx.example.com
# 管理后台的对外地址，同时注入给 app（主站用户菜单的后台入口，留空则隐藏该入口）
# 与 admin 容器。admin 服务未配置时后台页面里的主站链接降级为纯文本。
ADMIN_BASE_URL=https://admin.xxx.example.com

# 密钥：随机生成，且与测试环境不同
JWT_SECRET=change-me-random-at-least-32-characters
CREDENTIAL_MASTER_KEY=change-me-random-32-bytes-exact!

ADMIN_EMAIL=admin@xxx.example.com
ADMIN_PASSWORD=change-me-strong-admin
# 正式环境绝不能开启测试数据（测试账号密码是公开的）
SEED_TEST_DATA=false

MAIL_DRIVER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@xxx.example.com
SMTP_PASSWORD=change-me-smtp-token
SMTP_FROM=no-reply@xxx.example.com
SMTP_SECURITY=ssl
REGISTRATION_ENABLED=true
FREE_GRANT_ENABLED=false
FREE_GRANT_CAMPAIGN_ID=
FREE_GRANT_DAILY_BUDGET_MICROS=
FREE_GRANT_RISK_THRESHOLD=

STORAGE_DRIVER=local
MEDIA_ROOT=/data/media

# ===== 点数与支付 =====
ENTITLEMENT_DAYS=30
PRICING_PROMOTION_ENABLED=true

# ===== 媒体水印 =====
# 灰度发布前保持 false；开启前必须把 CJK 字体（如 Noto Sans SC）挂载/放置到 FONT_PATH 指向的
# 容器内可读路径，否则 api 启动即失败（fail-fast）。烧录文案默认「优刻 AI」。
WATERMARK_ENABLED=false
WATERMARK_FONT_PATH=
WATERMARK_TEXT=优刻 AI
# 支付回调地址必须公网可达；留空时按 APP_BASE_URL 推导
PAYMENT_NOTIFY_URL=
# 只配置要上架的渠道；未配置的渠道在充值页自动不可选
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_RETURN_URL=
ALIPAY_PRODUCTION=true
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_MCH_SERIAL_NO=
WECHATPAY_MCH_PRIVATE_KEY=
WECHATPAY_API_V3_KEY=
# 易支付（聚合通道）：ENABLED=true 时 API_BASE/PID/KEY 必须完整，缺失会导致 api 启动失败；API_BASE 强制 https
EASYPAY_ENABLED=false
EASYPAY_API_BASE=
EASYPAY_PID=
EASYPAY_KEY=
# 支付方式：alipay | wxpay，默认 alipay
EASYPAY_TYPE=alipay
# 支付完成后的浏览器回跳地址（充值页）
EASYPAY_RETURN_URL=

# ===== AI 转发（第四期）=====
AI_IMAGE_TIMEOUT=180s
AI_AUDIO_TIMEOUT=120s
AI_STREAM_TIMEOUT=600s
AI_STREAM_IDLE_TIMEOUT=60s
AI_VIDEO_TASK_TIMEOUT=20m
AI_ALLOW_PRIVATE_UPSTREAM=false

# ===== 内容审核（第五期）=====
# 测试环境可用 fake；正式环境必须切到 nsfwjs+detoxify 并显式配置 fail mode
MODERATION_ENABLED=false
MODERATION_PROVIDER=fake
# 仅 fake provider 生效：命中即触发拒绝的文本片段，逗号分隔；正式环境一般留空
MODERATION_FAKE_REJECT_TEXTS=
MODERATION_NSFWJS_ENDPOINT=
MODERATION_DETOXIFY_ENDPOINT=
MODERATION_IMAGE_THRESHOLD=0.6
MODERATION_TEXT_THRESHOLD=0.8
MODERATION_VIDEO_SAMPLE_FPS=1
MODERATION_FAIL_MODE=
MODERATION_TIMEOUT=5s
MODERATION_POLICY_VERSION=v1
MODERATION_QUARANTINE_TTL=24h
MODERATION_CACHE_TTL=10m

# ===== OIDC Provider（M3）=====
# RS256 签名私钥（PEM PKCS#8）。测试/本地可留空（启动生成临时密钥，重启后旧 token 失效）；
# 生产环境必须配置持久私钥，配置了但解析失败会拒绝启动（fail-fast）。
OIDC_JWKS_PRIVATE_KEY=

# ===== 博客站（深夜排字房）=====
# 内容变更后按需再验证：api 回调 blog-web /api/revalidate；两处 SECRET 必须一致。
# URL 为空 = 关闭再验证（本地只跑 Go 时），前台缓存按 300s 兜底过期。
BLOG_REVALIDATE_URL=http://blog-web:3101
BLOG_REVALIDATE_SECRET=
BLOG_WEB_IMAGE=
BLOG_WEB_PORT=3101
BLOG_SITE_URL=https://blog.youc.online
NEXT_PUBLIC_LOGIN_URL=https://youc.online/login
