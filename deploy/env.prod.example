# ===== 正式环境（xxx 域名）=====
# 复制成 deploy/env.prod 后填写，并保存在服务器上（不要提交进 git）。

MYSQL_DATABASE=infinite_canvas
MYSQL_USER=canvas
MYSQL_PASSWORD=change-me-strong-random
MYSQL_ROOT_PASSWORD=change-me-strong-random-root
DATABASE_URL=canvas:change-me-strong-random@tcp(db:3306)/infinite_canvas?charset=utf8mb4&parseTime=True&loc=UTC

# 正式环境必须是 production，否则会显示测试环境标识
SITE_ENV=production
API_BASE_URL=
APP_BASE_URL=https://xxx.example.com
COOKIE_SECURE=true
TRUSTED_PROXIES=172.16.0.0/12
LOG_LEVEL=info

# 密钥：随机生成，且与测试环境不同
JWT_SECRET=change-me-random-at-least-32-characters
CREDENTIAL_MASTER_KEY=change-me-random-32-bytes-exact!

ADMIN_EMAIL=admin@xxx.example.com
ADMIN_PASSWORD=change-me-strong-admin
# 正式环境绝不能开启测试数据（测试账号密码是公开的）
SEED_TEST_DATA=false

MAIL_DRIVER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@xxx.example.com
SMTP_PASSWORD=change-me-smtp-token
SMTP_FROM=no-reply@xxx.example.com
SMTP_SECURITY=ssl
REGISTRATION_ENABLED=true
FREE_GRANT_ENABLED=false
FREE_GRANT_CAMPAIGN_ID=
FREE_GRANT_DAILY_BUDGET_MICROS=
FREE_GRANT_RISK_THRESHOLD=

STORAGE_DRIVER=local
MEDIA_ROOT=/data/media

# ===== 点数与支付 =====
ENTITLEMENT_DAYS=30
PRICING_PROMOTION_ENABLED=true
# 支付回调地址必须公网可达；留空时按 APP_BASE_URL 推导
PAYMENT_NOTIFY_URL=
# 只配置要上架的渠道；未配置的渠道在充值页自动不可选
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_RETURN_URL=
ALIPAY_PRODUCTION=true
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_MCH_SERIAL_NO=
WECHATPAY_MCH_PRIVATE_KEY=
WECHATPAY_API_V3_KEY=

# ===== AI 转发（第四期）=====
AI_IMAGE_TIMEOUT=180s
AI_AUDIO_TIMEOUT=120s
AI_STREAM_TIMEOUT=600s
AI_STREAM_IDLE_TIMEOUT=60s
AI_VIDEO_TASK_TIMEOUT=20m
AI_ALLOW_PRIVATE_UPSTREAM=false

# ===== 内容审核（第五期）=====
# 测试环境可用 fake；正式环境必须切到 nsfwjs+detoxify 并显式配置 fail mode
MODERATION_ENABLED=false
MODERATION_PROVIDER=fake
MODERATION_NSFWJS_ENDPOINT=
MODERATION_DETOXIFY_ENDPOINT=
MODERATION_IMAGE_THRESHOLD=0.6
MODERATION_TEXT_THRESHOLD=0.8
MODERATION_VIDEO_SAMPLE_FPS=1
MODERATION_FAIL_MODE=
MODERATION_TIMEOUT=5s
MODERATION_POLICY_VERSION=v1
MODERATION_QUARANTINE_TTL=24h
MODERATION_CACHE_TTL=10m
