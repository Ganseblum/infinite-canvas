# worke 栈环境变量（复制为 .env 后填写；此文件含机密，勿入库）
# 数据库（worke 专属 MySQL 容器，卷在 ./data/mysql）
MYSQL_DATABASE=worke
MYSQL_USER=worke
MYSQL_PASSWORD=changeit-mysql
MYSQL_ROOT_PASSWORD=changeit-root

# 服务密钥（两套环境必须不同；CREDENTIAL_MASTER_KEY 必须恰好 32 字节）
JWT_SECRET=please-change-to-a-32-plus-char-secret
CREDENTIAL_MASTER_KEY=changeit-exactly-32-bytes-long!!
APP_BASE_URL=https://work.youc.online
SITE_ENV=test
SEED_TEST_DATA=true

# 管理员（启动种子）
ADMIN_EMAIL=admin@worke.local
ADMIN_PASSWORD=changeit-admin

# 免费点数（新用户每日赠送，保证注册即可用）
FREE_GRANT_ENABLED=true
FREE_GRANT_CAMPAIGN_ID=worke-daily
FREE_GRANT_DAILY_BUDGET_MICROS=200000000
FREE_GRANT_RISK_THRESHOLD=90

# 契约二共享密钥（api 与 office-agent 必须一致；部署时随机生成）
OFFICE_INTERNAL_TOKEN=changeit-internal-token

# 模型网关（Anthropic 兼容协议）
ANTHROPIC_BASE_URL=https://newapi.epsq.cn
ANTHROPIC_AUTH_TOKEN=sk-xxxx
ANTHROPIC_MODEL=glm-5.3
