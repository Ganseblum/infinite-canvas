# ===== 测试环境（sim-xxx 域名）=====
# 复制成 deploy/env.test 后填写；只改标了「测试环境」的地方即可。

# 镜像与端口：镜像 tag 按环境区分，测试构建不会覆盖正式镜像；
# 端口只绑 127.0.0.1，公网访问一律由宿主机 nginx 反代到该端口
APP_IMAGE=infinite-canvas:test
API_IMAGE=infinite-canvas-api:test
ADMIN_IMAGE=infinite-canvas-admin:test
APP_PORT=3100
ADMIN_PORT=3101

# compose 项目名兜底：deploy.sh 已用 -p infinite-canvas-test 隔离（-p 优先级更高），
# 这里防有人绕过 deploy.sh 直接 docker compose 时与正式环境混用容器与数据目录
COMPOSE_PROJECT_NAME=infinite-canvas-test

# 数据库：与正式库分开（可以是同实例的不同库，也可以是独立实例）
MYSQL_DATABASE=infinite_canvas_test
MYSQL_USER=canvas_test
MYSQL_PASSWORD=change-me-test
MYSQL_ROOT_PASSWORD=change-me-test-root
DATABASE_URL=canvas_test:change-me-test@tcp(db:3306)/infinite_canvas_test?charset=utf8mb4&parseTime=True&loc=UTC

# 测试环境标识：会给页面顶栏加上环境标识；正式环境必须是 production
SITE_ENV=test
# 前后端同源部署时留空；分开部署才填 API 地址
API_BASE_URL=
APP_BASE_URL=https://sim-xxx.example.com
COOKIE_SECURE=true
TRUSTED_PROXIES=172.16.0.0/12
# 跨源白名单：逗号分隔的完整来源（scheme://host[:port]，不带路径、尾斜杠或通配符），例如 https://sim-admin.youc.online
# 留空即完全不启用 CORS；同源部署无需配置
# 管理后台是独立域名，测试环境必须填上它的来源，否则 admin 的跨源请求会被浏览器拦下
CORS_ALLOWED_ORIGINS=https://sim-admin.youc.online
LOG_LEVEL=debug

# ===== 管理后台（独立容器，sim-admin.youc.online）=====
# 注意与上面的 API_BASE_URL 是两个不同的键，别混：
#   API_BASE_URL       主站前端的，同源部署时留空，由 app 容器内 nginx 反代 /api；
#   ADMIN_API_BASE_URL 管理后台的，必须是非空绝对地址（admin 域上没有 /api，留空会让请求打到 admin 自己身上变 404，
#                      admin 容器入口脚本会因此拒绝启动）
ADMIN_API_BASE_URL=https://sim-art.youc.online
# 管理后台的对外地址，注入给 app（主站用户菜单的后台入口，留空则隐藏该入口）
# 与 admin 容器（入口脚本 / 页面里指向主站的绝对链接）。admin 服务未配置时后台页面里的主站链接降级为纯文本。
ADMIN_BASE_URL=https://sim-admin.youc.online

# 密钥：每个环境必须不同，绝不能与正式环境共用（共用意味着测试环境签发的令牌能在正式环境通过校验）
JWT_SECRET=change-me-test-at-least-32-characters-long
CREDENTIAL_MASTER_KEY=change-me-test-32-bytes-exactly!

# 测试环境管理员与测试账号
ADMIN_EMAIL=admin@sim-xxx.example.com
ADMIN_PASSWORD=change-me-test-admin
SEED_TEST_DATA=true
SEED_TEST_DATA_EMAIL=test@example.com
SEED_TEST_DATA_PASSWORD=test123456

# 测试环境用日志驱动发信，验证/重置链接直接打在容器日志里
MAIL_DRIVER=log
REGISTRATION_ENABLED=true
FREE_GRANT_ENABLED=false
FREE_GRANT_CAMPAIGN_ID=
FREE_GRANT_DAILY_BUDGET_MICROS=
FREE_GRANT_RISK_THRESHOLD=

# 媒体：与正式环境分开目录/桶，避免测试文件混进正式存储
STORAGE_DRIVER=local
MEDIA_ROOT=/data/media

# ===== 点数与支付 =====
ENTITLEMENT_DAYS=30
PRICING_PROMOTION_ENABLED=true
# 测试环境默认不上架任何支付渠道，需要联调时再填其中一组
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_RETURN_URL=
ALIPAY_PRODUCTION=false
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_MCH_SERIAL_NO=
WECHATPAY_MCH_PRIVATE_KEY=
WECHATPAY_API_V3_KEY=

# ===== AI 转发（第四期）=====
AI_IMAGE_TIMEOUT=180s
AI_AUDIO_TIMEOUT=120s
AI_STREAM_TIMEOUT=600s
AI_STREAM_IDLE_TIMEOUT=60s
AI_VIDEO_TASK_TIMEOUT=20m
AI_ALLOW_PRIVATE_UPSTREAM=false

# ===== 内容审核（第五期）=====
# 测试环境可用 fake；正式环境必须切到 nsfwjs+detoxify 并显式配置 fail mode
MODERATION_ENABLED=false
MODERATION_PROVIDER=fake
# 仅 fake provider 生效：命中即触发拒绝的文本片段，逗号分隔，用于拒绝链路联调
MODERATION_FAKE_REJECT_TEXTS=
MODERATION_NSFWJS_ENDPOINT=
MODERATION_DETOXIFY_ENDPOINT=
MODERATION_IMAGE_THRESHOLD=0.6
MODERATION_TEXT_THRESHOLD=0.8
MODERATION_VIDEO_SAMPLE_FPS=1
MODERATION_FAIL_MODE=
MODERATION_TIMEOUT=5s
MODERATION_POLICY_VERSION=v1
MODERATION_QUARANTINE_TTL=24h
MODERATION_CACHE_TTL=10m
