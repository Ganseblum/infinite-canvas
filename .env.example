# 无限画布自部署 Compose 环境变量示例
# 复制为 .env 后修改，切勿把真实密钥提交到仓库。
# 根目录 compose（docker-compose.yml）与本地 compose（docker-compose.local.yml）都会读取本文件做插值；
# api 服务读取其中的业务变量；MYSQL_* 同时用于 db 容器初始化。
#
# 本地自部署镜像由 compose 本地构建（APP_IMAGE / API_IMAGE / ADMIN_IMAGE 指向构建产物 tag），
# 不使用上游发布镜像。以下变量必须修改后再启动，否则 api 会拒绝启动、整栈起不来：
#   - JWT_SECRET：至少 32 字符随机串（openssl rand -hex 32）
#   - CREDENTIAL_MASTER_KEY：正好 32 字节随机串（openssl rand -hex 16）
#   - ADMIN_EMAIL / ADMIN_PASSWORD：管理员初始账号
#   - FREE_GRANT_* 四件套：FREE_GRANT_ENABLED=true 时另外三项必填且大于 0；不启用免费额度可直接设 FREE_GRANT_ENABLED=false

# ===== Compose =====
# compose 顶层项目名（容器/网络前缀）。命令行 -p 与 deploy.sh 会覆盖它；测试/正式部署用 deploy/env.* 里的值隔离。
COMPOSE_PROJECT_NAME=infinite-canvas
# 本地构建的镜像 tag 与对外端口（compose 只绑 127.0.0.1，公网走宿主机反代）
APP_IMAGE=infinite-canvas:local
API_IMAGE=infinite-canvas-api:local
ADMIN_IMAGE=infinite-canvas-admin:local
APP_PORT=3000
ADMIN_PORT=3001
# 管理后台独立容器要连的主站 API 绝对地址（admin 域上没有 /api，必须非空）；同源自部署填主站地址即可
ADMIN_API_BASE_URL=http://localhost:3000

# ===== 数据库 =====
# 仅在数据卷首次初始化时生效；改这里的值不会改动已有数据库账号，必须先删除 data/mysql 数据目录。
MYSQL_DATABASE=infinite_canvas
MYSQL_USER=canvas
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# host 说明：容器内（docker compose 全栈）用服务名 db:3306；本机 go run / DBeaver 用 127.0.0.1:13306
# （该端口由 docker-compose.local.yml 或 deploy/compose.test.yml 映射，docker-compose.yml 本身不映射数据库端口）。
# 全栈部署保持下面这行不动；本机 go run 时改用注释里的连接串。
DATABASE_URL=canvas:change-me@tcp(db:3306)/infinite_canvas?charset=utf8mb4&parseTime=True&loc=UTC
# DATABASE_URL=canvas:change-me@tcp(127.0.0.1:13306)/infinite_canvas?charset=utf8mb4&parseTime=True&loc=UTC
# 想快速起一个不依赖 MySQL 的本地验证实例时，改成 sqlite:/绝对路径.db 即可（仅限本地验证）

# ===== 服务 =====
PORT=8080
LOG_LEVEL=info
# 站点对外地址，用于拼接验证/重置邮件里的链接，部署时必须与真实访问地址一致
APP_BASE_URL=http://localhost:3000
# 是否给 refresh cookie 加 Secure 属性；无 TLS 的内网/本地填 false，公网必须 true
COOKIE_SECURE=false
# 逗号分隔 CIDR；仅信任这些来源的 X-Real-IP / X-Forwarded-For。
# compose 中 nginx 与 api 处于同一容器网络，填容器网络网段。
TRUSTED_PROXIES=172.16.0.0/12
# 跨源白名单：逗号分隔完整来源（如 https://admin.example.com）；留空 = 完全关闭 CORS
CORS_ALLOWED_ORIGINS=

# ===== 前端 =====
# production 之外的值会在页面顶栏显示环境标识（如 test 显示「测试环境」）
SITE_ENV=production
# 前端与 /api 同源时留空；前后端分开部署才填完整地址
API_BASE_URL=
# 管理后台对外地址：主站用户菜单的后台入口用它拼绝对地址，留空则整个入口隐藏
ADMIN_BASE_URL=

# ===== 安全 =====
# 至少 32 字符随机串
JWT_SECRET=请改成至少32字符的随机串
# 必须为 32 字节，第四期渠道密钥复用同一把
CREDENTIAL_MASTER_KEY=请改成正好32字节的随机串

# ===== 管理员 =====
# 仅当该邮箱用户不存在时创建；已存在则提升为 admin，绝不重置已有密码
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=请改成管理员初始密码

# ===== 邮件 =====
# smtp 走真实邮件服务；log 只把邮件内容打到日志，本地开发/无 SMTP 环境用
MAIL_DRIVER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=请改成发信邮箱
# QQ 邮箱填授权码，不是登录密码
SMTP_PASSWORD=请改成邮箱授权码
SMTP_FROM=请改成发信邮箱
SMTP_SECURITY=ssl

# ===== 注册与赠送 =====
REGISTRATION_ENABLED=true
# 启用免费赠送时以下三项必填且大于 0，无默认值；缺失会导致 api 启动失败
FREE_GRANT_ENABLED=true
FREE_GRANT_CAMPAIGN_ID=
FREE_GRANT_DAILY_BUDGET_MICROS=
FREE_GRANT_RISK_THRESHOLD=

# ===== 点数与支付 =====
# 充值默认延长的付费权益天数，档位上的 entitlement_days 可以覆盖它
ENTITLEMENT_DAYS=30
# 限时折扣总开关；关闭后所有新报价回到基础价
PRICING_PROMOTION_ENABLED=true

# ===== 媒体水印 =====
# 灰度发布前保持 false；开启前必须把 CJK 字体（如 Noto Sans SC）挂载/放置到 FONT_PATH 指向的
# 容器内可读路径，否则 api 启动即失败（fail-fast）。烧录文案默认「优刻 AI」。
WATERMARK_ENABLED=false
WATERMARK_FONT_PATH=
WATERMARK_TEXT=优刻 AI
# 支付回调基地址，缺省由 APP_BASE_URL 推导为 {APP_BASE_URL}/api/payments/webhook/alipay|wechat|easypay
PAYMENT_NOTIFY_URL=
# 支付宝：三项都配置后才上架；未配置时充值页不出现支付宝渠道
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_RETURN_URL=
# 沙箱联调保持 false
ALIPAY_PRODUCTION=false
# 微信支付：五项都配置后才上架；私钥填 PEM 文件路径
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_MCH_SERIAL_NO=
WECHATPAY_MCH_PRIVATE_KEY=
WECHATPAY_API_V3_KEY=
# 易支付（彩虹协议，聚合通道）：ENABLED=true 时 API_BASE/PID/KEY 必须完整，缺失会导致 api 启动失败
EASYPAY_ENABLED=false
# 网关地址，如 https://pay.example.com；正式环境强制 https
EASYPAY_API_BASE=
EASYPAY_PID=
# 商户密钥，仅服务端保存，禁止写进日志与响应
EASYPAY_KEY=
# 支付方式：alipay | wxpay，默认 alipay
EASYPAY_TYPE=alipay
# 支付完成后的浏览器回跳地址（充值页）
EASYPAY_RETURN_URL=

# ===== 内容审核（第五期）=====
# 审核总开关；公开运营必须为 true。开启时 MODERATION_FAIL_MODE 必填，缺失会导致 api 启动失败
MODERATION_ENABLED=false
# fake（本地开发/测试）或 nsfwjs+detoxify（两个推理服务）
MODERATION_PROVIDER=fake
# nsfwjs+detoxify 时必填；用 compose 的 moderation profile 启动 sidecar 后填服务名地址
# （http://nsfwjs:8080 与 http://detoxify:8000，两个 sidecar 只监听 compose 内网，不经 nginx 暴露）
MODERATION_NSFWJS_ENDPOINT=
MODERATION_DETOXIFY_ENDPOINT=
# 仅 MODERATION_PROVIDER=fake 时生效：命中即触发拒绝的文本片段，逗号分隔，用于联调拒绝链路
MODERATION_FAKE_REJECT_TEXTS=
# 违规判定阈值与抽帧频率
MODERATION_IMAGE_THRESHOLD=0.6
MODERATION_TEXT_THRESHOLD=0.8
MODERATION_VIDEO_SAMPLE_FPS=1
# reject（默认运营模式）或 allow，无默认值
MODERATION_FAIL_MODE=
MODERATION_TIMEOUT=5s
MODERATION_POLICY_VERSION=v1
MODERATION_QUARANTINE_TTL=24h
MODERATION_CACHE_TTL=10m

# ===== AI 转发（第四期）=====
# 各能力超时，缺省 180s / 120s / 600s / 60s / 20m；平台渠道在管理后台配置
AI_IMAGE_TIMEOUT=180s
AI_AUDIO_TIMEOUT=120s
AI_STREAM_TIMEOUT=600s
AI_STREAM_IDLE_TIMEOUT=60s
AI_VIDEO_TASK_TIMEOUT=20m
# 仅本地调试内网上游时开启，正式环境必须为 false
AI_ALLOW_PRIVATE_UPSTREAM=false

# ===== 媒体存储 =====
# local 落 data/media 目录（容器内 /data/media）；s3 走 S3 兼容对象存储，桶必须保持私有。
STORAGE_DRIVER=local
MEDIA_ROOT=/data/media
# STORAGE_DRIVER=s3 时以下变量必填；S3_PRESIGN_TTL 必须等于 2 × S3_PRESIGN_ALIGN，
# 不满足会导致 api 启动失败。示例为 Cloudflare R2，换成 OSS/MinIO 时同步改端点。
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO 与部分自建服务需要 true，R2/OSS 保持 false
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_ALIGN=1h
S3_PRESIGN_TTL=2h

# ===== 测试数据 =====
# 测试数据开关：只在测试/预发布环境开启，会写入公开密码的测试账号
SEED_TEST_DATA=false
SEED_TEST_DATA_EMAIL=test@example.com
SEED_TEST_DATA_PASSWORD=test123456
