# ===== 数据库 =====
DATABASE_URL=root:root@tcp(127.0.0.1:3306)/infinite_canvas?charset=utf8mb4&parseTime=True&loc=UTC
# compose 网络内为 db:3306，本地 go run 为 127.0.0.1:3306

# ===== 服务 =====
PORT=8080
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# ===== 反向代理 =====
# 逗号分隔的 CIDR 列表。仅当请求来源命中受信网段时才采用 X-Real-IP / X-Forwarded-For，
# 否则一律使用 RemoteAddr。默认留空表示不信任任何代理头。
# compose 部署（nginx 与 api 同容器网络）时填写容器网络网段，例如 172.16.0.0/12。
TRUSTED_PROXIES=

# ===== 安全 =====
JWT_SECRET=<至少 32 字符随机串>
CREDENTIAL_MASTER_KEY=<32 字节，第四期渠道密钥复用>
COOKIE_SECURE=false

# ===== 管理员 =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<初始密码，创建后立即修改>

# ===== 邮件 =====
MAIL_DRIVER=log
# MAIL_DRIVER=smtp 时必填：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USERNAME=xxx@qq.com
# SMTP_PASSWORD=<邮箱授权码，非登录密码>
# SMTP_FROM=xxx@qq.com
# SMTP_SECURITY=ssl

# ===== 媒体存储 =====
# local 落 MEDIA_ROOT 磁盘目录，s3 走 S3 兼容对象存储
STORAGE_DRIVER=local
MEDIA_ROOT=/data/media
# STORAGE_DRIVER=s3 时以下变量必填；S3_PRESIGN_TTL 必须等于 2 × S3_PRESIGN_ALIGN，
# 不满足会直接启动失败。对象存储桶必须保持私有。
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MinIO 与部分自建服务需要路径风格寻址，R2/OSS 保持 false
# S3_FORCE_PATH_STYLE=false
# S3_PRESIGN_ALIGN=1h
# S3_PRESIGN_TTL=2h

# ===== 注册 =====
REGISTRATION_ENABLED=true

# ===== 免费赠送 =====
# 启用时以下三项必填且大于 0，无默认值；缺失会导致服务启动失败
FREE_GRANT_ENABLED=true
FREE_GRANT_CAMPAIGN_ID=
FREE_GRANT_DAILY_BUDGET_MICROS=
FREE_GRANT_RISK_THRESHOLD=