# Go 内容 API（Next 服务端内网拉取，不经公网）
BLOG_API_BASE=http://127.0.0.1:8080/api/v1/blog
# 互动同域代理目标（next.config rewrites 用）
BLOG_API_INTERNAL=http://127.0.0.1:8080
# 再验证共享密钥（与 Go 侧 BLOG_REVALIDATE_SECRET 一致）
REVALIDATE_SECRET=change-me
# 站点绝对地址（sitemap / RSS / canonical）
BLOG_SITE_URL=https://blog.youc.online
# 主应用登录页（评论/收藏登录回跳用）
NEXT_PUBLIC_LOGIN_URL=https://youc.online/login
